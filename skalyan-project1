.globl main
.equ STDOUT, 1
.equ STDIN, 0
.equ __NR_READ, 63
.equ __NR_WRITE, 64
.equ __NR_EXIT, 93

.text

# Function to read from stdin into a buffer
read_string:
    # Function prologue
    addi sp, sp, -16
    sw ra, 0(sp)

    # Read from stdin
    li a7, __NR_READ    # System call number for read
    li a0, STDIN        # File descriptor for stdin
    mv a1, a0           # Move buffer pointer to a1
    mv a2, a1           # Move buffer pointer to a2
    ecall               # Execute read system call

    # Function epilogue
    lw ra, 0(sp)
    addi sp, sp, 16
    ret

# Function to write to stdout from a buffer
write_string:
    # Function prologue
    addi sp, sp, -16
    sw ra, 0(sp)

    # Write to stdout
    li a7, __NR_WRITE   # System call number for write
    li a0, STDOUT       # File descriptor for stdout
    mv a1, a0           # Move buffer pointer to a1
    ecall               # Execute write system call

    # Function epilogue
    lw ra, 0(sp)
    addi sp, sp, 16
    ret

# Main function
main:
    # Main prologue
    addi sp, sp, -104
    sw ra, 100(sp)

    # Write the prompt to the terminal (stdout)
    li a7, __NR_WRITE
    li a0, STDOUT
    la a1, prompt
    addi a2, zero, prompt_end - prompt        
    ecall

    #  Read up to 100 characters from the terminal (stdin)
    li a7, __NR_READ
    li a0, STDIN
    mv a1, sp
    addi a2, zero, 100
    ecall

    # Write the just read characters to the terminal (stdout)
    mv a2, a0
    li a7, __NR_WRITE
    li a0, STDOUT
    mv a1, sp
    ecall

    # Main epilogue
    lw ra, 100(sp)
    addi sp, sp, 104
    jalr ra, ra, 0      # Return from the main function using jalr

.data
prompt:   .ascii  "Enter a message: "
prompt_end:



